      "task_id": "cvb-avs-0954",
      "prompt": "Make an audio-driven video in the windswept coastal pier where three objects fall at different times. Synchronization rule: each impact matches its sound. Maintain identity, natural motion, stable framing, and exact audiovisual order without speaker swaps, anticipatory motion, or delayed impacts.",
      "mode": "generation",
      "duration_seconds": 12,
      "metadata": {
        "benchmark": "complex_video_bench_1k",
        "benchmark_version": "1.0",
        "category": "audio_video_sync",
        "task_family": "audio_video_sync",
        "split": "train",
        "scenario_group": "audio_video_sync_group_006",
        "difficulty": 5,
        "expected_failure_modes": [
          "motion_mismatch",
          "identity_drift",
          "prompt_omission"
        ],
        "constraints": [
          "audio_event_alignment",
          "speaker_attribution",
          "event_order",
          "identity_consistency"
        ],
        "evaluation": {
          "audio_event_alignment": {
            "threshold": 0.9,
            "weight": 1.0,
            "aggregation": "mean"
          },
          "speaker_attribution": {
            "threshold": 0.9,
            "weight": 1.0,
            "aggregation": "mean"
          },
          "event_order": {
            "threshold": 0.9,
            "weight": 1.0,
            "aggregation": "minimum_over_segments"
          },
          "subject_consistency": {
            "threshold": 0.9,
            "weight": 1.0,
            "aggregation": "mean"
          }
        },
        "reward": {
          "objective": "task_conditioned_multimodal_reward",
          "video_quality_weight": 0.5
        },
        "allowed_tools": [
          "audio_analyzer",
          "timeline_planner",
          "audio_conditioned_video_generator",
          "lip_sync_tool",
          "av_sync_verifier",
          "segment_repair"
