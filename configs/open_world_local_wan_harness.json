{
  "name": "open_world_local_wan_harness",
  "output_dir": "outputs/harness_open_world_local_wan",
  "task_files": [
    "benchmarks/video_skill_graph_core.json"
  ],
  "limit_per_suite": 1,
  "max_candidates": 2,
  "min_quality_gain": 0.02,
  "evolution_iterations": 3,
  "frontier_size": 2,
  "no_improvement_limit": 3,
  "categories_per_batch": 1,
  "samples_per_category": 1,
  "cache_enabled": true,
  "evaluation_seeds": [42, 123, 456],
  "exploratory_admission_enabled": true,
  "exploratory_min_worst_seed_gain": 0.05,
  "exploratory_min_stability_gain": 0.02,
  "exploratory_max_pair_regression": 0.03,
  "auto_consolidate_foundation": true,
  "min_support": 1,
  "min_utility": 0.0,
  "max_motif_size": 4,
  "max_foundation_skills": 3,
  "ablations": [
    "full"
  ],
  "runtime": {
    "provider": "local-wan",
    "duration": 6,
    "video_output_dir": "outputs/harness_open_world_local_wan_videos",
    "sample_frames": 6,
    "timeout_seconds": 900,
    "vlm_timeout_seconds": 90,
    "vlm_max_images": 6,
    "wan_task": "t2v-1.3B",
    "wan_size": "832*480",
    "wan_python": "python",
    "wan_extra_args": "--offload_model True --t5_cpu --sample_shift 8 --sample_guide_scale 6",
    "wan_save_arg": "--save_file",
    "wan_seed_arg": "--base_seed",
    "strict_eval": true,
    "evolve_on_lte_095": true,
    "enable_llm_mutation": true,
    "template_mutations_enabled": true,
    "graph_llm_model": "openai/gpt-5.6-sol",
    "graph_llm_base_url": "https://openrouter.ai/api/v1",
    "graph_llm_reasoning_effort": "medium",
    "open_world_graph_invention": true,
    "open_world_graph_ideas": 6,
    "open_world_graph_realization_budget": 3,
    "open_world_graph_max_nodes": 8,
    "open_world_graph_wl_threshold": 0.82,
    "enable_open_world_tools": true,
    "enable_mcp_tools": false,
    "mcp_servers_config": "configs/mcp_servers_volcengine.json",
    "tool_acquisition_policy": "local_first",
    "open_world_max_candidates": 4,
    "open_world_sandbox_backend": "docker",
    "open_world_docker_bin": "docker"
  }
}
